# Copy to .env.local and fill in. .env.local is git-ignored.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered. Without a verified domain in Resend,
# this must be the email address the Resend account was created with.
CONTACT_TO_EMAIL=

# Optional sender. Leave empty to use Resend's test sender (onboarding@resend.dev);
# set it to an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL=
